def load_knowledge():
    knowledge = ""
    knowledge_dir = Path("knowledge")

    if not knowledge_dir.exists():
        return knowledge

    for filename in sorted(knowledge_dir.iterdir()):
        if filename.suffix.lower() == ".txt":
            knowledge += "\n--- " + filename.name + " ---\n"
            knowledge += filename.read_text(encoding="utf-8")

    return knowledge


def retrieve_knowledge(question):
    knowledge = load_knowledge()
    if not knowledge.strip():
        return "No local knowledge available."

    question_words = set(question.lower().split())
    sections = knowledge.split("--- ")
    scored = []

    for section in sections:
        words = set(section.lower().split())
        score = len(question_words & words)
        if score > 0:
            scored.append((score, section))

    scored.sort(key=lambda x: x[0], reverse=True)
    if scored:
        return "--- ".join(section for score, section in scored[:3])

    return "No directly relevant information found."

