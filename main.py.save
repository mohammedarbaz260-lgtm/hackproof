from openai import OpenAI

client = OpenAI()

print("=================================")
print("        HACKPROOF AI")
print("=================================")
print("Type 'exit' to quit.\n")

while True:
    user_input = input("You: ")

    if user_input.lower() == "exit":
        print("HackProof: Goodbye!")
        break

    response = client.responses.create(
        model="gpt-5.6",
        instructions=(
            "You are HackProof, a cybersecurity learning assistant. "
            "Explain cybersecurity concepts clearly and safely. "
            "Help users learn ethical hacking, networking, Linux, "
            "SOC, web security, and defensive security."
        ),
        input=user_input
    )

    print("HackProof:", response.output_text)
    print()print("🛡️ Hackproof is starting...")
print("Cybersecurity AI Assistant")
print("Status: Online")
